@model WumpusWorld.Models.GameViewModel

@{
    Layout = null;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        width: 100%;
        min-height: 100%;
    }

    body {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        background-color: #081A19;
        overflow: hidden;
    }

    .side-column {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        perspective: 1200px;
    }

    .side-panel {
        width: 85%;
        height: 90vh;
        position: relative;
        background: transparent;
        border: none;
        box-shadow: none;
        transform-style: preserve-3d;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        will-change: transform;
    }

    .panel-bg-img {
        position: absolute;
        top: -40px;
        left: -45px;
        width: 120%;
        height: 110%;
        z-index: -1;
        pointer-events: none;
    }

    body > .side-column:nth-child(1) .side-panel {
        transform: rotateY(8deg);
        transform-origin: left center;
    }

    body > .side-column:nth-child(3) .side-panel {
        transform: rotateY(-8deg);
        transform-origin: right center;
    }

    .log-panel-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 20px;
    }

    .side-header-3d-wrapper {
        perspective: 1000px;
        margin-bottom: 15px;
        width: 100%;
    }

    .log-panel-header-3d {
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: 2px;
        display: flex;
        align-items: center;
        text-align: center;
        gap: 15px;
        padding-bottom: 4px;
        transform-style: preserve-3d;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        will-change: transform;
    }

        .log-panel-header-3d span {
            display: inline-block;
            transform: translateZ(0);
            backface-visibility: hidden;
            /* Mirroring the control button text style */
            font-weight: bold;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
            color: #ffffff;
        }

        .log-panel-header-3d::before,
        .log-panel-header-3d::after {
            content: "";
            flex: 1;
            height: 3px;
        }

    body > .side-column:nth-child(1) .log-panel-header-3d {
        transform: rotateY(15deg);
        transform-origin: left center;
    }

        body > .side-column:nth-child(1) .log-panel-header-3d span {
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
        }

        body > .side-column:nth-child(1) .log-panel-header-3d::before,
        body > .side-column:nth-child(1) .log-panel-header-3d::after {
            background: linear-gradient( 90deg, rgba(240, 200, 105, 0) 0%, rgba(240, 200, 105, 0.4) 50%, rgba(240, 200, 105, 0) 100% );
        }

    body > .side-column:nth-child(3) .log-panel-header-3d span {
        color: #ffffff;
        text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }

        body > .side-column:nth-child(3) .log-panel-header-3d span {
            color: #8fcfc4;
            text-shadow: 0 0 8px rgba(94, 234, 212, 0.3);
        }

        body > .side-column:nth-child(3) .log-panel-header-3d::before,
        body > .side-column:nth-child(3) .log-panel-header-3d::after {
            background: linear-gradient( 90deg, rgba(143, 207, 196, 0) 0%, rgba(143, 207, 196, 0.4) 50%, rgba(143, 207, 196, 0) 100% );
        }

    .log-stream {
        flex: 1;
        background-color: #121213;
        border: 1px solid #2d2d30;
        border-radius: 4px;
        padding: 14px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-family: Consolas, 'Courier New', Courier, monospace;
        font-size: 13px;
        line-height: 1.5;
    }

        .log-stream::-webkit-scrollbar {
            width: 8px;
        }

        .log-stream::-webkit-scrollbar-track {
            background: #121213;
            border-radius: 0 4px 4px 0;
        }

        .log-stream::-webkit-scrollbar-thumb {
            background: #4f4c43;
            border-radius: 4px;
            border: 1px solid #2d2d30;
        }

            .log-stream::-webkit-scrollbar-thumb:hover {
                background: #625f54;
                border-color: #8fcfc4;
            }

    .log-entry {
        color: #d4d4d4;
        word-break: break-word;
        border-left: 2px solid #4f4c43;
        padding-left: 8px;
    }

    .log-turn-header {
        color: #8fcfc4;
        font-weight: bold;
        border-bottom: 1px solid rgba(143, 207, 196, 0.4);
        padding-top: 12px;
        padding-bottom: 4px;
        margin-bottom: 4px;
        border-left: none;
        padding-left: 0;
        width: 100%;
    }

    .prefix-tag {
        font-weight: bold;
    }

    .prefix-brain {
        color: #c084fc;
    }

    .prefix-action {
        color: #fb923c;
    }

    .prefix-sensors {
        color: #22d3ee;
    }

    .prefix-agent {
        color: #4ade80;
    }

    .prefix-tell {
        color: #38bdf8;
    }

    .prefix-ask {
        color: #f43f5e;
    }

    .prefix-cnf {
        color: #eab308;
    }

    .prefix-resolution {
        color: #a855f7;
    }

    .prefix-default {
        color: #f0c869;
    }

    .middle-column {
        width: 800px;
        display: flex;
        flex-direction: column;
        height: 100vh;
        flex-shrink: 0;
        justify-content: flex-start;
        align-items: center;
    }

    .game-display-container {
        width: 760px;
        height: 800px;
        background-image: url('/images/bg.png');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        border: 3px solid #081A19;
        border-radius: 0 0 10px 10px;
        box-shadow: inset 8px 0px 12px -4px rgba(0, 0, 0, 0.35), inset -8px 0px 12px -4px rgba(0, 0, 0, 0.35), inset 0px -12px 16px -4px rgba(0, 0, 0, 0.35);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 40px;
        overflow: hidden;
        flex-shrink: 0;
        padding-bottom: 25px;
    }

    .header-3d-wrapper {
        margin-top: 50px;
        perspective: 1000px;
        width: 500px;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .header-panel {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 20px;
        transform: rotateX(-24deg);
        transform-origin: top center;
        transform-style: preserve-3d;
        z-index: 1;
    }

    .header-label {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #8CF8E5;
        font-weight: 600;
        text-shadow: 0 0 8px rgba(94, 234, 212, 0.3);
        margin-bottom: 5px;
    }

    .header-content {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
        
        width: 100%;
        margin-top: 30px;
    }

    .score-value {
        font-size: 38px;
        font-weight: bold;
        color: #f0c869;
        line-height: 1.1;
        text-shadow: 0 0 14px rgba(240, 200, 105, 0.45), 0 2px 3px rgba(0, 0, 0, 0.6);
    }

    .panel-background {
        position: absolute;
        top: -20px;
        left: -10%;
        width: 120%;
        height: 140%;
        object-fit: fill;
        z-index: -1;
        pointer-events: none;
    }

    .stat-icon, .stat-divider, .score-block, .coin-icon {
        position: relative;
        z-index: 1;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        filter: drop-shadow(0 0 5px rgba(94, 234, 212, 0.5));
    }

    .coin-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        filter: drop-shadow(0 0 5px rgba(94, 234, 212, 0.5));
        flex-shrink: 0;
    }

    .item-depleted {
        filter: grayscale(100%) opacity(35%) !important;
    }

    .stat-divider {
        width: 1px;
        height: 100px;
        background: rgba(110, 231, 211, 0.3);
        flex-shrink: 0;
    }

    .score-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        min-width: 250px;
    }

    .score-label {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #8fcfc4;
        font-weight: 600;
        text-shadow: 0 0 8px rgba(94, 234, 212, 0.3);
    }

    .score-value {
        font-size: 42px;
        font-weight: bold;
        color: #f0c869;
        line-height: 1.1;
        text-shadow: 0 0 14px rgba(240, 200, 105, 0.45), 0 2px 3px rgba(0, 0, 0, 0.6);
    }

    .grid-3d-wrapper {
        perspective: 1000px;
        width: 650px;
        height: 650px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

    .simulation-grid {
        width: 100%;
        height: 100%;
        background-color: transparent;
        border-radius: 10px;
        transform: rotateX(14deg);
        transform-origin: bottom center;
        transform-style: preserve-3d;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.45);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 1fr);
        overflow: hidden;
    }

    .grid-tile {
        background-image: url('/images/floor.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top: 3px solid #2c2c2e;
        border-right: 3px solid #2c2c2e;
    }

    .simulation-grid .grid-tile:nth-child(-n+4) {
        border-top: none;
    }

    .simulation-grid .grid-tile:nth-child(4n) {
        border-right: none;
    }

    .grid-tile img {
        position: absolute;
        width: 75%;
        height: 75%;
        object-fit: contain;
        pointer-events: none;
    }

    .pit-icon {
        z-index: 2;
    }

    .wumpus-icon {
        z-index: 3;
    }

    .agent-icon {
        z-index: 4;
    }

    .gold-icon {
        z-index: 5 !important;
        width: 40% !important;
        position: absolute;
        bottom: -10px;
    }

    .breeze-icon {
        z-index: 6;
    }

    .stench-icon {
        z-index: 7;
    }

    .agent-direction-icon {
        position: absolute;
        top: -5px;
        right: 8px;
        font-size: 36px;
        font-weight: bold;
        color: #5eead4;
        text-shadow: 0 0 10px rgba(94, 234, 212, 0.65), 0px 2px 3px rgba(0, 0, 0, 0.85);
        z-index: 10;
        pointer-events: none;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .tile-coords {
        position: absolute;
        bottom: 6px;
        right: 8px;
        font-family: monospace;
        font-size: 14px;
        font-weight: bold;
        color: #fff;
        pointer-events: none;
        z-index: 12;
    }

    .controller-panel {
        flex: 1;
        width: 100%;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;
        gap: 25px;
        flex-shrink: 0;
        perspective: 1000px;
    }

        .controller-panel form {
            transform-style: preserve-3d;
        }

        .controller-panel form:nth-of-type(1) {
            transform-style: preserve-3d;
            transform: rotateY(24deg);
            transform-origin: left center;
        }

        .controller-panel form:nth-of-type(3) {
            transform-style: preserve-3d;
            transform: rotateY(-24deg);
            transform-origin: right center;
        }

    .control-btn {
        background-image: url('/images/button.png');
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-color: transparent;
        border: none;
        color: #ffffff;
        font-weight: bold;
        cursor: pointer;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }

        .control-btn:disabled {
            filter: grayscale(100%) opacity(0.5);
            cursor: not-allowed;
        }

        .control-btn:hover:not(:disabled) {
            filter: brightness(1.2);
        }

    .btn-left-tilt {
        width: 180px;
        height: 50px;
    }

    .btn-right-tilt {
        width: 180px;
        height: 50px;
    }

    .btn-center {
        width: 270px;
        height: 75px;
    }

    .slow-thinking-overlay {
        position: fixed;
        top: 250px;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 24px;
        z-index: 9999;
        pointer-events: none;
        animation: fadeInOut 6s forwards;
        opacity: 0;
    }

    @@keyframes fadeInOut {
        0% {
            opacity: 0;
        }

        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    .slow-thinking-video {
        position: fixed;
        top: 400px;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 400px;
        z-index: 10000;
        pointer-events: none;
        animation: fadeInOutVideo 8s forwards;
        animation-delay: 2s;
        opacity: 0;
    }

    @@keyframes fadeInOutVideo {
        0%

    {
        opacity: 0;
    }

    12.5% {
        opacity: 1;
    }
    96.5% {
        opacity: 1;
    }
    100% {
        opacity: 0;
    }
    }

    #kb {
        color: #fff;
        font-family: 'Times New Roman', Times, serif;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    }
</style>

<body>

    <div class="side-column">
        <div class="side-panel">
            <img src="/images/panel.png" class="panel-bg-img" />
            <div class="log-panel-container">
                <div class="side-header-3d-wrapper">
                    <div class="log-panel-header-3d"><span>System Logs</span></div>
                </div>
                <div id="logStream" class="log-stream">
                    @foreach (var log in WumpusWorld.Logging.Logger.Logs) {
                        if (!string.IsNullOrEmpty(log)) {
                            var trimmedLog = log.Trim();
                            if (trimmedLog.StartsWith("[TURN") && trimmedLog.EndsWith("]")) {
                                var cleanTurnText = trimmedLog.Trim('[', ']');
                                <div class="log-entry log-turn-header">@cleanTurnText</div>
                            } else if (trimmedLog.StartsWith("[") && trimmedLog.Contains("]")) {
                                int closeBracketIdx = trimmedLog.IndexOf(']');
                                var prefix = trimmedLog.Substring(0, closeBracketIdx + 1);
                                var remainderText = trimmedLog.Substring(closeBracketIdx + 1);

                                string prefixClass = prefix.ToUpper() switch {
                                    "[BRAIN]" => "prefix-brain",
                                    "[ACTION]" => "prefix-action",
                                    "[SENSORS]" => "prefix-sensors",
                                    "[AGENT]" => "prefix-agent",
                                    _ => "prefix-default"
                                };

                                <div class="log-entry">
                                    <span class="prefix-tag @prefixClass">@prefix</span>@remainderText
                                </div>
                            } else {
                                <div class="log-entry">@log</div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="middle-column">
        <div class="game-display-container">
            <div class="header-3d-wrapper">
                <div class="header-panel">
                    <img src="/images/scoreboard.png" class="panel-background" />

                    <div class="header-label">Score</div>

                    <div class="header-content">
                        @{
                            bool hasArrow = Model.Simulation.AgentState?.HasArrow ?? false;
                            bool hasGold = Model.Simulation.AgentState?.HasGold ?? false;
                            string arrowClass = hasArrow ? "stat-icon" : "stat-icon item-depleted";
                            string goldClass = hasGold ? "coin-icon" : "coin-icon item-depleted";
                        }
                        <img src="/images/arrow.png" class="@arrowClass" />
                        <div class="score-value">@(Model.Simulation.AgentState?.Score ?? 0)</div>
                        <img src="/images/gold.png" class="@goldClass" />
                    </div>
                </div>
            </div>

            <div class="grid-3d-wrapper">
                <div class="simulation-grid">
                    @for (int y = 4; y >= 1; y--) {
                        @for (int x = 1; x <= 4; x++) {
                            var cell = Model.GetCellAssets(x, y);
                            <div class="grid-tile">
                                @if (cell.HasPit) {
                                    <img src="/images/pit.png" class="pit-icon" alt="Pit" />
                                }
                                @if (cell.HasWumpus) {
                                    <img src="/images/wumpus.png" alt="Wumpus" class="wumpus-icon" />
                                }
                                @if (cell.AgentImage != null) {
                                    <img src="/images/agent.png" class="agent-icon" alt="Agent" />
                                    var arrowSymbol = Model.Simulation.AgentState.Facing switch {
                                        WumpusWorld.Logic.Agent.Data.Direction.Up => "↑",
                                        WumpusWorld.Logic.Agent.Data.Direction.Down => "↓",
                                        WumpusWorld.Logic.Agent.Data.Direction.Left => "←",
                                        WumpusWorld.Logic.Agent.Data.Direction.Right => "→",
                                        _ => ""
                                    };
                                    <span class="agent-direction-icon">@arrowSymbol</span>
                                }
                                @if (cell.HasGold) {
                                    <img src="/images/gold.png" class="gold-icon" alt="Gold" />
                                }
                                @if (cell.HasBreeze) {
                                    <img src="/images/breeze.png" class="breeze-icon" alt="Breeze" />
                                }
                                @if (cell.HasStench) {
                                    <img src="/images/stench.png" class="stench-icon" alt="Stench" />
                                }
                                <span class="tile-coords">@x,@y</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="controller-panel">
            <form asp-controller="Home" asp-action="InitializeGame" method="post" onsubmit="disableAllButtons();">
                <button type="submit" class="control-btn btn-left-tilt">Reset Map</button>
            </form>
            <form asp-controller="Home" asp-action="NextMove" method="post" onsubmit="disableAllButtons();">
                <button type="submit" class="control-btn btn-center">Next Turn</button>
            </form>
            <form asp-controller="Home" asp-action="RandomizeMap" method="post" onsubmit="disableAllButtons();">
                <button type="submit" class="control-btn btn-right-tilt">Randomize</button>
            </form>
        </div>
    </div>

    <div class="side-column">
        <div class="side-panel">
            <div class="log-panel-container">

                <img src="/images/panel.png" class="panel-bg-img" />
                <div class="side-header-3d-wrapper">
                    <div class="log-panel-header-3d"><span id="kb">Knowledge Base</span></div>
                </div>
                <div id="kbLogStream" class="log-stream">
                    @{
                        int currentX = Model.Simulation.AgentState?.Position.X ?? 1;
                        int currentY = Model.Simulation.AgentState?.Position.Y ?? 1;

                        bool skipCurrentQueryBlock = false;
                        var seenQueriesInCurrentTurn = new HashSet<string>();
                        var currentBlockLines = new List<(string Prefix, string PrefixClass, string Text)>();
                    }

                    @foreach (var log in WumpusWorld.Logging.KbLogger.Logs) {
                        if (!string.IsNullOrEmpty(log)) {
                            var trimmedLog = log.Trim();

                            if (trimmedLog.Contains("↔") || (trimmedLog.StartsWith("[TELL]") && trimmedLog.Contains("¬(W_") && trimmedLog.Contains("∨"))) {
                                continue;
                            }

                            if (trimmedLog.StartsWith("[TURN") && trimmedLog.EndsWith("]")) {
                                if (currentBlockLines.Any() && !skipCurrentQueryBlock) {
                                    foreach (var line in currentBlockLines) {
                                        <div class="log-entry">
                                            @if (!string.IsNullOrEmpty(line.Prefix)) {
                                                <span class="prefix-tag @line.PrefixClass">@line.Prefix</span>
                                            }
                                            @line.Text
                                        </div>
                                    }
                                }
                                currentBlockLines.Clear();
                                skipCurrentQueryBlock = false;
                                seenQueriesInCurrentTurn.Clear();

                                var cleanTurnText = trimmedLog.Trim('[', ']');
                                <div class="log-entry log-turn-header">@cleanTurnText</div>
                                continue;
                            }

                            if (trimmedLog.StartsWith("[") && trimmedLog.Contains("]")) {
                                int closeBracketIdx = trimmedLog.IndexOf(']');
                                var prefix = trimmedLog.Substring(0, closeBracketIdx + 1);
                                var remainderText = trimmedLog.Substring(closeBracketIdx + 1);
                                string upperPrefix = prefix.ToUpper();

                                if (upperPrefix == "[ASK]") {
                                    if (currentBlockLines.Any() && !skipCurrentQueryBlock) {
                                        foreach (var line in currentBlockLines) {
                                            <div class="log-entry">
                                                @if (!string.IsNullOrEmpty(line.Prefix)) {
                                                    <span class="prefix-tag @line.PrefixClass">@line.Prefix</span>
                                                }
                                                @line.Text
                                            </div>
                                        }
                                    }
                                    currentBlockLines.Clear();
                                    skipCurrentQueryBlock = false;

                                    string queryKey = remainderText.Trim();

                                    var match = System.Text.RegularExpressions.Regex.Match(remainderText, @"_([1-4])_([1-4])");
                                    if (match.Success) {
                                        int targetX = int.Parse(match.Groups[1].Value);
                                        int targetY = int.Parse(match.Groups[2].Value);
                                        int distance = Math.Abs(currentX - targetX) + Math.Abs(currentY - targetY);

                                        if (distance > 1) {
                                            skipCurrentQueryBlock = true;
                                        }
                                    }

                                    if (!skipCurrentQueryBlock) {
                                        if (seenQueriesInCurrentTurn.Contains(queryKey)) {
                                            skipCurrentQueryBlock = true;
                                        } else {
                                            seenQueriesInCurrentTurn.Add(queryKey);
                                        }
                                    }
                                }

                                string prefixClass = upperPrefix switch {
                                    "[TELL]" => "prefix-tell",
                                    "[ASK]" => "prefix-ask",
                                    "[CNF]" => "prefix-cnf",
                                    "[RESOLUTION]" => "prefix-resolution",
                                    _ => "prefix-default"
                                };

                                if (upperPrefix == "[ASK]" || upperPrefix == "[CNF]" || upperPrefix == "[RESOLUTION]") {
                                    if (!skipCurrentQueryBlock) {
                                        currentBlockLines.Add((prefix, prefixClass, remainderText));
                                    }
                                } else {
                                    if (currentBlockLines.Any() && !skipCurrentQueryBlock) {
                                        foreach (var line in currentBlockLines) {
                                            <div class="log-entry">
                                                @if (!string.IsNullOrEmpty(line.Prefix)) {
                                                    <span class="prefix-tag @line.PrefixClass">@line.Prefix</span>
                                                }
                                                @line.Text
                                            </div>
                                        }
                                    }
                                    currentBlockLines.Clear();

                                    <div class="log-entry">
                                        <span class="prefix-tag @prefixClass">@prefix</span>@remainderText
                                    </div>
                                }
                            } else {
                                if (!skipCurrentQueryBlock) {
                                    currentBlockLines.Add(("", "", trimmedLog));
                                }
                            }
                        }
                    }

                    @if (currentBlockLines.Any() && !skipCurrentQueryBlock) {
                        foreach (var line in currentBlockLines) {
                            <div class="log-entry">
                                @if (!string.IsNullOrEmpty(line.Prefix)) {
                                    <span class="prefix-tag @line.PrefixClass">@line.Prefix</span>
                                }
                                @line.Text
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        
    </div>

    @if (Model.ShowSlowThinkingWarning) {
        <video id="tooSlowVideo" class="slow-thinking-video" playsinline>
            <source src="@Url.Content("~/videos/tooSlow.mp4")" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <div id="slowThinkingMsg" class="slow-thinking-overlay">
            The agent may not be fast, but he is trying his best 🙂
        </div>

    }

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            var logStream = document.getElementById("logStream");
            if (logStream) logStream.scrollTop = logStream.scrollHeight;

            var kbLogStream = document.getElementById("kbLogStream");
            if (kbLogStream) kbLogStream.scrollTop = kbLogStream.scrollHeight;

            var video = document.getElementById("tooSlowVideo");
            var text = document.getElementById("slowThinkingMsg");

            if (video) {
                function hasShownWarning() {
                    return document.cookie.split(';').some((item) => item.trim().startsWith('wumpus_slow_warning=true'));
                }

                function setWarningCookie() {
                    var date = new Date();
                    date.setTime(date.getTime() + (20 * 60 * 1000));
                    document.cookie = "wumpus_slow_warning=true; expires=" + date.toUTCString() + "; path=/";
                }

                if (!hasShownWarning()) {
                    setWarningCookie();

                    setTimeout(function() {
                        video.volume = 0.25;
                        video.play().catch(function(error) {
                            console.log("Autoplay prevented:", error);
                        });
                    }, 2000);

                    setTimeout(function() {
                        if (video) video.remove();
                        if (text) text.remove();
                    }, 11500);
                } else {
                    video.remove();
                    if (text) text.remove();
                }
            }
        });

        function disableAllButtons() {
            var buttons = document.querySelectorAll('.controller-panel .control-btn');
            buttons.forEach(function(btn) {
                btn.disabled = true;
                btn.style.opacity = "0.5";
                btn.style.cursor = "not-allowed";
            });
        }
    </script>
</body>